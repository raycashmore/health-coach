# Add real values only in a local, untracked .env.local file when the
# corresponding integration is introduced. Do not put personal data here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
AI_GATEWAY_API_KEY=

# Required for a production web intake deployment. Use HTTP Basic authentication
# with the fixed username `owner` and this token as the password.
INTAKE_ACCESS_TOKEN=
