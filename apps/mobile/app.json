{
  "expo": {
    "name": "Health Coach",
    "slug": "health-coach",
    "scheme": "health-coach",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.example.healthcoach",
      "permissions": ["android.permission.health.READ_STEPS", "android.permission.health.READ_SLEEP"]
    },
    "plugins": [
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ]
  }
}
