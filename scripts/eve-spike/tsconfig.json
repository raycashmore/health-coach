{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["agent/**/*.ts", "evals/**/*.ts", "live/agent/**/*.ts", "live/evals/**/*.ts"]
}
